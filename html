    <style>
        :root {
            color-scheme: dark;
        }

        * {
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            margin: 0;
            min-height: 100vh;
            font-family: 'Cairo', 'Inter', sans-serif;
            background:
                radial-gradient(
                    circle at 15% 10%,
                    rgba(34,197,94,.08),
                    transparent 28%
                ),
                radial-gradient(
                    circle at 85% 20%,
                    rgba(14,165,233,.06),
                    transparent 26%
                ),
                #050914;
            color: #f8fafc;
            overflow-x: hidden;
        }

        body::before {
            content: "";
            position: fixed;
            inset: 0;
            pointer-events: none;
            opacity: .035;
            z-index: -1;
            background-image:
                linear-gradient(
                    rgba(255,255,255,.4) 1px,
                    transparent 1px
                ),
                linear-gradient(
                    90deg,
                    rgba(255,255,255,.4) 1px,
                    transparent 1px
                );
            background-size: 55px 55px;
        }

        ::selection {
            background: #22c55e;
            color: #020617;
        }

        .glass {
            background:
                linear-gradient(
                    135deg,
                    rgba(19,34,53,.82),
                    rgba(7,13,27,.72)
                );
            border: 1px solid rgba(148,163,184,.12);
            backdrop-filter: blur(18px);
            -webkit-backdrop-filter: blur(18px);
        }

        .glass-strong {
            background:
                linear-gradient(
                    135deg,
                    rgba(15,30,48,.96),
                    rgba(4,9,20,.94)
                );
            border: 1px solid rgba(148,163,184,.14);
            backdrop-filter: blur(20px);
        }

        .hero-grid {
            position: absolute;
            inset: 0;
            opacity: .13;
            background-image:
                linear-gradient(
                    rgba(34,197,94,.3) 1px,
                    transparent 1px
                ),
                linear-gradient(
                    90deg,
                    rgba(34,197,94,.3) 1px,
                    transparent 1px
                );
            background-size: 44px 44px;
            mask-image: linear-gradient(
                to bottom,
                black,
                transparent
            );
        }

        .glow-orb {
            position: absolute;
            border-radius: 9999px;
            filter: blur(70px);
            pointer-events: none;
        }

        .orb-green {
            width: 280px;
            height: 280px;
            background: rgba(34,197,94,.13);
        }

        .orb-blue {
            width: 230px;
            height: 230px;
            background: rgba(14,165,233,.09);
        }

        .nav-btn {
            position: relative;
            transition:
                background .25s ease,
                color .25s ease,
                transform .25s ease,
                border-color .25s ease;
        }

        .nav-btn:hover {
            transform: translateX(-2px);
            color: #fff;
            background: rgba(255,255,255,.035);
        }

        html[dir="ltr"] .nav-btn:hover {
            transform: translateX(2px);
        }

        .nav-btn.active {
            color: #4ade80;
            background: rgba(34,197,94,.10);
            border-color: rgba(34,197,94,.22);
            box-shadow:
                inset 0 0 25px rgba(34,197,94,.025);
        }

        .nav-btn.active::before {
            content: "";
            position: absolute;
            right: -1px;
            top: 20%;
            height: 60%;
            width: 3px;
            border-radius: 10px;
            background: #22c55e;
            box-shadow: 0 0 14px rgba(34,197,94,.8);
        }

        html[dir="ltr"] .nav-btn.active::before {
            right: auto;
            left: -1px;
        }

        .tab-content {
            animation: tabIn .4s ease both;
        }

        @keyframes tabIn {
            from {
                opacity: 0;
                transform: translateY(8px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .metric-card {
            position: relative;
            overflow: hidden;
            transition:
                transform .25s ease,
                border-color .25s ease,
                box-shadow .25s ease;
        }

        .metric-card::after {
            content: "";
            position: absolute;
            width: 100px;
            height: 100px;
            right: -35px;
            top: -35px;
            border-radius: 9999px;
            background: rgba(34,197,94,.07);
            filter: blur(12px);
        }

        .metric-card:hover {
            transform: translateY(-4px);
            border-color: rgba(34,197,94,.24);
            box-shadow: 0 18px 45px rgba(0,0,0,.20);
        }

        .stat-chip {
            display: flex;
            align-items: center;
            gap: .8rem;
            padding: .9rem 1rem;
            border-radius: 1rem;
            background:
                linear-gradient(
                    135deg,
                    rgba(15,23,42,.92),
                    rgba(15,23,42,.56)
                );
            border: 1px solid rgba(148,163,184,.12);
            transition:
                transform .25s ease,
                border-color .25s ease,
                box-shadow .25s ease;
        }

        .stat-chip:hover {
            transform: translateY(-3px);
            border-color: rgba(52,211,153,.3);
            box-shadow: 0 15px 35px rgba(0,0,0,.2);
        }

        .stat-icon {
            width: 2.6rem;
            height: 2.6rem;
            display: grid;
            place-items: center;
            border-radius: .8rem;
            color: #34d399;
            background: rgba(34,197,94,.1);
            border: 1px solid rgba(34,197,94,.15);
            flex-shrink: 0;
        }

        .stat-label {
            display: block;
            color: #64748b;
            font-size: .65rem;
        }

        .stat-chip strong {
            display: block;
            color: #f8fafc;
            font-size: .8rem;
            margin-top: .15rem;
        }

        .scenario-btn {
            padding: .55rem 1rem;
            border-radius: .75rem;
            border: 1px solid rgba(148,163,184,.18);
            background: rgba(15,23,42,.7);
            color: #94a3b8;
            font-size: .75rem;
            font-weight: 700;
            transition: all .25s ease;
        }

        .scenario-btn:hover {
            color: white;
            border-color: rgba(34,197,94,.45);
            transform: translateY(-1px);
        }

        .scenario-btn.active {
            color: #06120b;
            background: linear-gradient(
                135deg,
                #22c55e,
                #34d399
            );
            border-color: #22c55e;
            box-shadow: 0 8px 25px rgba(34,197,94,.2);
        }

        .metric-pop {
            animation: metricPop .35s ease;
        }

        @keyframes metricPop {
            0% {
                transform: scale(.94);
                opacity: .55;
            }

            100% {
                transform: scale(1);
                opacity: 1;
            }
        }

        .pulse-dot {
            animation: pulseDot 1.8s infinite;
        }

        @keyframes pulseDot {
            0%,
            100% {
                box-shadow: 0 0 0 0 rgba(52,211,153,.4);
            }

            50% {
                box-shadow: 0 0 0 7px rgba(52,211,153,0);
            }
        }

        .timeline-line {
            position: absolute;
            top: 50%;
            left: 7%;
            right: 7%;
            height: 2px;
            background:
                linear-gradient(
                    90deg,
                    rgba(34,197,94,.15),
                    rgba(34,197,94,.7),
                    rgba(34,197,94,.15)
                );
            transform: translateY(-50%);
        }

        html[dir="rtl"] .timeline-line {
            background:
                linear-gradient(
                    90deg,
                    rgba(34,197,94,.15),
                    rgba(34,197,94,.7),
                    rgba(34,197,94,.15)
                );
        }

        .timeline-node {
            position: relative;
            z-index: 2;
            transition: transform .25s ease;
        }

        .timeline-node:hover {
            transform: scale(1.04);
        }

        .process-card {
            transition:
                transform .25s ease,
                border-color .25s ease,
                box-shadow .25s ease;
        }

        .process-card:hover {
            transform: translateY(-5px);
            border-color: rgba(34,197,94,.28);
            box-shadow: 0 20px 45px rgba(0,0,0,.2);
        }

        .bmc-card {
            transition:
                transform .25s ease,
                border-color .25s ease,
                background .25s ease;
        }

        .bmc-card:hover {
            transform: translateY(-3px);
            border-color: rgba(255,255,255,.15);
            background: rgba(15,23,42,.86);
        }

        .gradient-text {
            background:
                linear-gradient(
                    135deg,
                    #ffffff 20%,
                    #86efac 70%,
                    #34d399
                );
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
        }

        .progress-track {
            background: rgba(30,41,59,.8);
            overflow: hidden;
            border-radius: 999px;
        }

        .progress-fill {
            position: relative;
            overflow: hidden;
        }

        .progress-fill::after {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient(
                90deg,
                transparent,
                rgba(255,255,255,.25),
                transparent
            );
            animation: shimmer 2.2s infinite;
        }

        @keyframes shimmer {
            from {
                transform: translateX(-100%);
            }

            to {
                transform: translateX(100%);
            }
        }

        .custom-scrollbar::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }

        .custom-scrollbar::-webkit-scrollbar-track {
            background: #070d19;
        }

        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: #1e3a5f;
            border-radius: 999px;
        }

        .custom-scrollbar::-webkit-scrollbar-thumb:hover {
            background: #22c55e;
        }

        input[type="range"] {
            accent-color: #22c55e;
        }

        input[type="range"]::-webkit-slider-thumb {
            width: 20px;
            height: 20px;
            border-radius: 50%;
            background: #22c55e;
            cursor: pointer;
            box-shadow: 0 0 0 5px rgba(34,197,94,.12);
        }

        .toast {
            position: fixed;
            bottom: 24px;
            left: 50%;
            transform: translate(-50%, 120px);
            opacity: 0;
            z-index: 100;
            transition: all .35s ease;
        }

        .toast.show {
            transform: translate(-50%, 0);
            opacity: 1;
        }

        .mobile-menu {
            animation: menuIn .25s ease both;
        }

        @keyframes menuIn {
            from {
                opacity: 0;
                transform: translateY(-8px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .number-font {
            font-family: 'Inter', 'Cairo', sans-serif;
            letter-spacing: -.02em;
        }

        @media (max-width: 1023px) {
            .timeline-line {
                display: none;
            }
        }

        @media (max-width: 640px) {
            .hero-title {
                font-size: 2rem;
            }
        }
    </style>
</head>

