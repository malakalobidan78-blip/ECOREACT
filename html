            const costPerM2 =
                ECO_DATA.pricing.productionCostPerM2;


            const revenue =
                area * price;

            const productionCost =
                area * costPerM2;

            const grossProfit =
                revenue - productionCost;

            const grossMargin =
                revenue > 0
                    ? (grossProfit / revenue) * 100
